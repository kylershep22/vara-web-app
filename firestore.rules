rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========== HELPER FUNCTIONS ==========

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is the owner of a resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if user can read a profile based on privacy settings.
    // Privacy model: "public" (default) or "private" (owner-only).
    // Legacy "connections" values are treated as "private".
    function canReadProfile(userId) {
      let profile = get(/databases/$(database)/documents/users/$(userId));
      let privacy = profile.data.privacy;

      // Owner can always read their own profile
      return request.auth.uid == userId
        // Default to public if privacy is not set
        || privacy == null
        || privacy == 'public';
      // "private" and "connections" (legacy) → only owner can read
    }

    // Check if user is a member of a group
    function isGroupMember(groupId) {
      let group = get(/databases/$(database)/documents/groups/$(groupId));
      return request.auth.uid in group.data.members;
    }

    // Check if user is the group owner
    function isGroupOwner(groupId) {
      let group = get(/databases/$(database)/documents/groups/$(groupId));
      return request.auth.uid == group.data.ownerId
        || request.auth.uid == group.data.createdBy
        || request.auth.uid == group.data.creatorId;
    }

    // Check if group is public
    function isPublicGroup(groupId) {
      let group = get(/databases/$(database)/documents/groups/$(groupId));
      return group.data.visibility == 'public' || group.data.type == 'public';
    }

    // Check if user has admin role
    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Check if user is not suspended or banned (auto-unsuspend if past expiry)
    // Returns true if user doc doesn't exist or has no moderation action
    function isActiveUser() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return !exists(userPath)
        || get(userPath).data.moderationStatus == null
        || get(userPath).data.moderationStatus == 'active'
        || (get(userPath).data.moderationStatus == 'suspended'
            && get(userPath).data.suspendedUntil != null
            && get(userPath).data.suspendedUntil < request.time);
    }

    // ========== USER PROFILES ==========

    match /users/{userId} {
      // Read: any authenticated user can read profiles
      // Privacy filtering is handled at the application layer
      allow read: if isAuthenticated();

      // Users can only create their own profile
      allow create: if request.auth.uid == userId;
      // Owner can update own doc; admins can update role + moderation fields only
      allow update: if (request.auth.uid == userId
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['role', 'moderationStatus', 'suspendedUntil']))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['role', 'moderationStatus', 'suspendedUntil', 'updatedAt']));

      // Users cannot delete their profile (use Cloud Function if needed)
      allow delete: if false;

      // Sub-collection: moods
      match /moods/{moodId} {
        allow read, write: if request.auth.uid == userId;
      }

      // Sub-collection: goals (legacy pattern)
      match /goals/{goalId} {
        allow read, write: if request.auth.uid == userId;
      }

      // Sub-collection: moderationHistory (admin-only)
      match /moderationHistory/{entryId} {
        allow read: if isAdmin();
        allow write: if false; // Cloud Functions use Admin SDK
      }
    }

    // ========== PERSONAL DATA COLLECTIONS ==========

    // Goals (top-level collection)
    match /goals/{goalId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Habits
    match /habits/{habitId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);

      // Sub-collection: completions (habit check-ins)
      match /completions/{completionId} {
        // Allow users to read/write completions for habits they own
        // Split read into get/list because list queries don't have resource == null
        allow get: if isAuthenticated() &&
          (resource == null ||
           request.auth.uid == get(/databases/$(database)/documents/habits/$(habitId)).data.userId);
        allow list: if isAuthenticated() &&
          request.auth.uid == get(/databases/$(database)/documents/habits/$(habitId)).data.userId;
        allow write: if isAuthenticated() &&
          (resource == null ||
           request.auth.uid == get(/databases/$(database)/documents/habits/$(habitId)).data.userId);
      }
    }

    // Tasks
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Journal Entries
    match /journalEntries/{entryId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Journal Entries (reflections) - snake_case version
    match /journal_entries/{entryId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Habit Completions (top-level collection for tracking)
    match /habitCompletions/{completionId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Joy Moments (gratitude and positive moments)
    match /joyMoments/{momentId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // 4-3-2-1 Daily Practice Entries
    match /fourThreeTwoOne/{entryId} {
      // Allow read if document doesn't exist (for checking before create) OR if user owns it
      allow read: if isAuthenticated() && (resource == null || isOwner(resource.data.userId));
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // ========== VARA WELLNESS SCORE ==========

    // Daily Wellness Scores (calculated composite scores)
    match /dailyWellnessScores/{scoreId} {
      // Allow read if document doesn't exist (for checking before create) OR if user owns it
      allow read: if isAuthenticated() && (resource == null || isOwner(resource.data.userId));
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Morning Check-Ins (quick subjective inputs)
    match /morningCheckIns/{checkInId} {
      // Allow read if document doesn't exist (for checking before create) OR if user owns it
      allow read: if isAuthenticated() && (resource == null || isOwner(resource.data.userId));
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Brain State Check-Ins (Dashboard V2 single-tap check-in)
    match /brainStateCheckIns/{checkInId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Daily Reflections (end-of-day difficulty signal)
    match /dailyReflections/{docId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ========== BRAIN HEALTH COLLECTIONS ==========

    // Brain Metrics (daily readiness scores and check-ins)
    match /brainMetrics/{metricId} {
      // Allow read if document doesn't exist (for checking before create) OR if user owns it
      allow read: if isAuthenticated() && (resource == null || isOwner(resource.data.userId));
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Neuroplasticity Signals (daily "did something uncomfortable")
    match /neuroplasticitySignals/{signalId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Nervous System Sessions (physiological sigh, panoramic vision)
    match /nervousSystemSessions/{sessionId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // AMCC Challenges (daily "do one hard thing")
    match /amccChallenges/{challengeId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Sleep Logs
    match /sleepLogs/{logId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Sleep Routines (document ID is userId)
    match /sleepRoutines/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Sleep Routine Runs (completion tracking)
    match /sleepRoutineRuns/{runId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // ========== COMMUNITY FEATURES ==========

    // Groups
    match /groups/{groupId} {
      // Read: public groups by anyone, private groups only by members
      // Check resource.data directly for queries to work
      // Support both old (visibility/type) and new (isPublic) field formats
      allow read: if isAuthenticated() && (
        resource.data.visibility == 'public' ||
        resource.data.type == 'public' ||
        resource.data.isPublic == true ||
        request.auth.uid in resource.data.members
      );

      // Create: any authenticated user can create a group
      // Support createdBy, ownerId, and creatorId fields for backwards compatibility
      allow create: if isAuthenticated() && isActiveUser() && (
        request.auth.uid == request.resource.data.ownerId ||
        request.auth.uid == request.resource.data.createdBy ||
        request.auth.uid == request.resource.data.creatorId
      );

      // Update: owner, members, or users joining public groups
      // Support createdBy, ownerId, and creatorId fields
      allow update: if isAuthenticated() && isActiveUser() && (
        // Owner/creator can update anything
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid == resource.data.createdBy ||
        request.auth.uid == resource.data.creatorId ||
        // Existing members can only update member-related fields (join/leave)
        (request.auth.uid in resource.data.members &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['members', 'memberCount', 'updatedAt'])) ||
        // Non-members can join PUBLIC groups (add themselves to members)
        (
          (resource.data.visibility == 'public' || resource.data.isPublic == true) &&
          request.auth.uid in request.resource.data.members &&
          !(request.auth.uid in resource.data.members)
        )
      );

      // Delete: only group owner
      // Support createdBy, ownerId, and creatorId fields
      allow delete: if isAuthenticated() && isActiveUser() && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid == resource.data.createdBy ||
        request.auth.uid == resource.data.creatorId
      );
    }

    // Posts (group forum posts)
    match /posts/{postId} {
      // Read: Public posts (no group) visible to all; group posts require membership
      allow read: if isAuthenticated() && (
        // Posts without a groupId are visible to all authenticated users
        resource.data.groupId == null ||
        !resource.data.keys().hasAny(['groupId']) ||
        // Group posts: user must be a member of the group
        (resource.data.groupId != null &&
         request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members)
      );

      // Create: if user is the author (support both userId and authorId fields)
      allow create: if isAuthenticated() && isActiveUser() &&
        (request.auth.uid == request.resource.data.userId ||
         request.auth.uid == request.resource.data.authorId) &&
        (
          // If it's a group post, user must be a member
          !request.resource.data.groupId ||
          request.resource.data.groupId == null ||
          (exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId)) &&
           request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.members)
        );

      // Update: post author can update anything, any authenticated user can like/comment
      allow update: if isAuthenticated() && isActiveUser() && (
        // Author can update anything
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.authorId ||
        // Any authenticated user can update likes, comments, and updatedAt
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'comments', 'likesCount', 'commentsCount', 'updatedAt'])
        )
      );

      // Delete: post author or group owner (if group post)
      allow delete: if isAuthenticated() && isActiveUser() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.authorId ||
        (resource.data.groupId &&
         exists(/databases/$(database)/documents/groups/$(resource.data.groupId)) &&
         request.auth.uid == get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.ownerId)
      );
    }

    // ========== CONTENT MODERATION ==========

    // Post Reports (user-submitted abuse reports)
    match /postReports/{reportId} {
      // Only the reporter can read/list their own reports
      allow get: if isAuthenticated() &&
        resource.data.reporterId == request.auth.uid;

      allow list: if isAuthenticated() &&
        request.auth.uid == resource.data.reporterId;

      // Any authenticated user can create a report for someone else's post
      allow create: if isAuthenticated() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.postId is string &&
        request.resource.data.reportedUserId is string &&
        request.resource.data.reason is string &&
        request.resource.data.reporterId != request.resource.data.reportedUserId;

      // Reports are immutable once submitted
      allow update, delete: if false;
    }

    // Hidden Posts (user hides a post from their feed)
    match /hiddenPosts/{hiddenId} {
      allow get: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      // List queries require the query to filter by userId == auth.uid
      allow list: if isAuthenticated() &&
        request.auth.uid == resource.data.userId;

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.postId is string;

      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      allow update: if false;
    }

    // Muted Users (user mutes another user's content)
    match /mutedUsers/{muteId} {
      allow get: if isAuthenticated() &&
        resource.data.muterId == request.auth.uid;

      // List queries require the query to filter by muterId == auth.uid
      allow list: if isAuthenticated() &&
        request.auth.uid == resource.data.muterId;

      allow create: if isAuthenticated() &&
        request.resource.data.muterId == request.auth.uid &&
        request.resource.data.mutedUserId is string &&
        request.resource.data.muterId != request.resource.data.mutedUserId;

      allow delete: if isAuthenticated() &&
        resource.data.muterId == request.auth.uid;

      allow update: if false;
    }

    // ========== CHALLENGES ==========

    match /challenges/{challengeId} {
      // Read: public/global visible to all authenticated, private to members, admin sees all
      allow read: if isAuthenticated() && (
        resource.data.visibility == 'public' ||
        resource.data.isGlobal == true ||
        request.auth.uid in resource.data.members ||
        isAdmin()
      );

      // Create: admins can create any challenge, regular users only non-global
      allow create: if isAuthenticated() && isActiveUser() &&
        (isAdmin()
         || (request.resource.data.isGlobal != true && request.auth.uid == request.resource.data.ownerId));

      // Update: owner/members for non-global, admins for global, public/global join
      allow update: if isAuthenticated() && isActiveUser() && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid in resource.data.members ||
        isAdmin() ||
        ((resource.data.visibility == 'public' || resource.data.isGlobal == true) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberCount', 'updatedAt', 'lastActivityAt']))
      );

      // Delete: owner for non-global, admin for any
      allow delete: if isAuthenticated() &&
        (isAdmin() || (request.auth.uid == resource.data.ownerId && resource.data.isGlobal != true));
    }

    // Challenge Participants (leaderboard and progress tracking)
    match /challengeParticipants/{participantId} {
      // Read: any authenticated user can see participants (for leaderboard)
      allow read: if isAuthenticated();

      // Create: user can create their own participant record
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.userId;

      // Update: user can update their own record (for stats)
      allow update: if isAuthenticated() &&
        request.auth.uid == resource.data.userId;

      // Delete: user can delete their own record (when leaving)
      allow delete: if isAuthenticated() &&
        request.auth.uid == resource.data.userId;
    }

    // Challenge Check-ins (daily/weekly progress)
    match /challengeCheckIns/{checkInId} {
      // Read: authenticated users can read check-ins (for activity feed)
      allow read: if isAuthenticated();

      // Create: user can create their own check-ins
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.userId;

      // Update/Delete: users cannot modify check-ins (immutable)
      allow update, delete: if false;
    }

    // ========== GROUP PROMPTS ==========

    // Group Prompts (weekly reflection prompts for groups)
    match /groupPrompts/{promptId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isGroupOwner(request.resource.data.groupId);
      allow update, delete: if isAuthenticated() && isGroupOwner(resource.data.groupId);
    }

    // ========== GROUP & CHALLENGE INVITES ==========

    // Group Invites
    match /groupInvites/{inviteId} {
      // Read: inviter or invitee can read
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.inviterId ||
        request.auth.uid == resource.data.inviteeId
      );

      // Create: inviter must be the authenticated user, and must have permission to invite
      // Permission check happens in the service layer since Firestore rules can't do complex lookups
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.inviterId;

      // Update: only invitee can update (to accept/decline)
      allow update: if isAuthenticated() &&
        request.auth.uid == resource.data.inviteeId &&
        request.resource.data.status in ['accepted', 'declined'];

      // Delete: inviter can cancel, invitee can remove declined invites
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.inviterId ||
        request.auth.uid == resource.data.inviteeId
      );
    }

    // Challenge Invites
    match /challengeInvites/{inviteId} {
      // Read: inviter or invitee can read
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.inviterId ||
        request.auth.uid == resource.data.inviteeId
      );

      // Create: inviter must be the authenticated user
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.inviterId;

      // Update: only invitee can update (to accept/decline)
      allow update: if isAuthenticated() &&
        request.auth.uid == resource.data.inviteeId &&
        request.resource.data.status in ['accepted', 'declined'];

      // Delete: inviter can cancel, invitee can remove
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.inviterId ||
        request.auth.uid == resource.data.inviteeId
      );
    }

    // ========== CONNECTIONS ==========

    // Connection Invites (pending connection requests)
    // Data model: { from, to, status: 'pending'|'accepted'|'declined' }
    match /connectionInvites/{inviteId} {
      // Read: if user is sender or recipient
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.to
      );

      // Create: if user is the sender
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.from;

      // Update: if user is sender or recipient (for status changes)
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.to
      );

      // Delete: if user is sender or recipient
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.to
      );
    }

    // Connections (unified collection for requests and accepted connections)
    // Data model: { requesterId, addresseeId, participants: [requesterId, addresseeId], status: 'pending'|'accepted'|'declined'|'canceled' }
    // Also supports mobile format: { requester, a, b }
    match /connections/{connectionId} {
      // Read: if user is one of the two people in the connection (a or b)
      // Also support legacy fields (requesterId, addresseeId, participants, requester)
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.a ||
        request.auth.uid == resource.data.b ||
        request.auth.uid == resource.data.requesterId ||
        request.auth.uid == resource.data.requester ||
        request.auth.uid == resource.data.addresseeId ||
        request.auth.uid in resource.data.participants
      );

      // Create: if user is one of the participants
      allow create: if isAuthenticated() && isActiveUser() && (
        request.auth.uid == request.resource.data.a ||
        request.auth.uid == request.resource.data.b ||
        request.auth.uid == request.resource.data.requesterId ||
        request.auth.uid == request.resource.data.requester ||
        request.auth.uid in request.resource.data.participants
      );

      // Update: if user is one of the two people in the connection
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.a ||
        request.auth.uid == resource.data.b ||
        request.auth.uid == resource.data.requesterId ||
        request.auth.uid == resource.data.requester ||
        request.auth.uid == resource.data.addresseeId
      );

      // Delete: if user is one of the two people in the connection
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.a ||
        request.auth.uid == resource.data.b ||
        request.auth.uid == resource.data.requesterId ||
        request.auth.uid == resource.data.requester ||
        request.auth.uid == resource.data.addresseeId
      );
    }

    // ========== MESSAGING ==========

    // Conversations
    match /conversations/{conversationId} {
      // Read: if document doesn't exist (checking before create) OR user is a participant
      allow read: if isAuthenticated() && (resource == null || request.auth.uid in resource.data.participants);

      // Create: if user is one of the participants
      allow create: if isAuthenticated() && isActiveUser() && request.auth.uid in request.resource.data.participants;

      // Update: if user is a participant (for lastMessage update)
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;

      // Delete: not allowed (use Cloud Function if needed)
      allow delete: if false;
    }

    // Direct Messages
    match /directMessages/{messageId} {
      // Read: if user is a participant in the conversation
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participants
      );

      // Create: if user is the sender AND a participant in the conversation
      allow create: if isAuthenticated() && isActiveUser() &&
        request.auth.uid == request.resource.data.senderId &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants;

      // Update/Delete: messages are immutable
      allow update, delete: if false;
    }

    // ========== NOTIFICATIONS ==========

    // Notifications
    match /notifications/{notificationId} {
      // Read: only the recipient (userId field in old code, recipientId in new)
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.recipientId
      );

      // Create: Cloud Functions create notifications (no direct user creation)
      allow create: if false;

      // Update: only recipient can update (to mark as read)
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.recipientId
      );

      // Delete: only recipient can delete
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.recipientId
      );
    }

    // Notification Preferences (document ID is userId)
    match /notificationPreferences/{userId} {
      // Users can only read/write their own notification preferences
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // App Configuration (feature flags, read-only for clients)
    match /config/{docId} {
      allow read: if isAuthenticated();
      // Write: admin SDK only (Cloud Functions)
    }

    // Notification Log (Cloud Functions dedup tracking, no client access)
    match /notificationLog/{userId}/{document=**} {
      // Admin SDK only (Cloud Functions) — no client access
      allow read, write: if false;
    }

    // ========== SHARED CONTENT ==========

    // Wellness Library (sleep sounds, meditation, movement content)
    match /wellnessLibrary/{itemId} {
      // Read: all authenticated users can read library content
      allow read: if isAuthenticated();

      // Write: content is managed by admins only
      // For now, allow no direct writes from clients
      allow write: if false;
    }

    // Tags (for interests, skills, etc.)
    match /tags/{tagId} {
      // Read: all authenticated users can read tags
      allow read: if isAuthenticated();

      // Write: tags are managed by admins only (via Cloud Functions or admin dashboard)
      // For now, allow no direct writes from clients
      allow write: if false;
    }

    // ========== BRAIN HEALTH COLLECTIONS ==========

    // Puzzles (read-only, admin-created content)
    match /puzzles/{puzzleId} {
      // Read: all authenticated users can read puzzles
      allow read: if isAuthenticated();
      // Write: admin only (no client writes)
      allow write: if false;
    }

    // Puzzle Completions (user owns their own completions)
    match /puzzleCompletions/{completionId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Focus Sessions (Pomodoro timer data)
    match /focusSessions/{sessionId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Routines (morning, evening, Sunday routines)
    match /routines/{routineId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Weekly Recaps (4-3-2-1 framework)
    match /weeklyRecaps/{recapId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Wheel of Life assessments
    match /wheelOfLife/{assessmentId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Reflections (deep purpose/values journaling)
    match /reflections/{reflectionId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Educational Content (admin-created, read-only)
    match /educationalContent/{contentId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin only
    }

    // Masterclasses (admin-created, read-only)
    match /masterclasses/{masterclassId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin only
    }

    // Masterclass Progress (user's learning progress)
    match /masterclassProgress/{progressId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Audio Library (binaural beats, admin-created)
    match /audioLibrary/{audioId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin only
    }

    // Audio Listens (user's listening history)
    match /audioListens/{listenId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Audio Favorites (user's favorited tracks)
    match /audioFavorites/{favoriteId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Social Connections (meaningful social interactions tracking)
    match /socialConnections/{connectionId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Nature Exposure (outdoor time tracking)
    match /natureExposure/{exposureId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Energy Check-ins (cognitive load monitoring)
    match /energyCheckins/{checkinId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Gratitude Entries
    match /gratitudeEntries/{entryId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Bedtime Routines (sleep routine tracking)
    match /bedtimeRoutines/{routineId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Emotional Check-ins (mood and emotion tracking)
    match /emotionalCheckins/{checkinId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Cognitive Reframes (CBT thought records)
    match /cognitiveReframes/{reframeId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Digital Wellbeing (screen time, break tracking)
    match /digitalWellbeing/{recordId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Brain Health Scores (composite metric)
    match /brainHealthScores/{scoreId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // ========== LIBRARY CONTENT ==========

    // Movement Content (videos/audio for movement library)
    match /movementContent/{contentId} {
      // Authenticated users can read all movement content
      allow read: if isAuthenticated();
      // Only admins/backend can write (not enforced here, managed via admin SDK)
      allow write: if false;
    }

    // ========== SYSTEM DATA ==========

    // Rate Limits (managed by Cloud Functions only)
    match /rateLimits/{userId} {
      // Users cannot read or write their rate limit data
      // Only Cloud Functions can manage this
      allow read, write: if false;

      // Subcollection for individual endpoint requests
      match /requests/{endpoint} {
        allow read, write: if false;
      }
    }

    // ========== ADMIN COLLECTIONS ==========

    // Admin analytics — read-only for admins, written by Cloud Functions
    match /adminAnalytics/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Moderation queue — admins read + update status fields only
    match /moderationQueue/{itemId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'reviewedBy', 'reviewedAt', 'action']);
      allow delete: if false;
    }

    // Moderation actions audit trail — admins create, no modifications
    match /moderationActions/{actionId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}

