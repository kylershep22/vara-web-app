# ==========================================
# PRODUCTION ENVIRONMENT
# ==========================================
# Configuration for production builds (App Store / Google Play)
#
# This file is used during EAS production builds:
#   eas build --profile production
#
# IMPORTANT: Add this to EAS Secrets instead of committing to git
# Run: eas secret:create --scope project --name EXPO_PUBLIC_API_URL --value https://your-api.com

# ==========================================
# FIREBASE CONFIGURATION (PRODUCTION)
# ==========================================

EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here

# iOS App ID (from Firebase Console after registering iOS app)
EXPO_PUBLIC_FIREBASE_IOS_APP_ID=your_ios_app_id_here

# Android App ID (from Firebase Console after registering Android app)
EXPO_PUBLIC_FIREBASE_ANDROID_APP_ID=your_android_app_id_here

# ==========================================
# BACKEND API CONFIGURATION (PRODUCTION)
# ==========================================

# Option 1: Firebase Functions (Recommended)
EXPO_PUBLIC_API_URL=https://your-cloud-functions-url

# Option 2: Custom Hosted Server
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com

EXPO_PUBLIC_API_BASE_PATH=/api

# ==========================================
# ENVIRONMENT
# ==========================================

EXPO_PUBLIC_ENV=production
EXPO_PUBLIC_DEBUG=false

# ==========================================
# SUBSCRIPTION CONFIGURATION
# ==========================================

# iOS In-App Purchase Product IDs (from App Store Connect)
EXPO_PUBLIC_IOS_PRODUCT_MONTHLY=com.vara.wellness.monthly
EXPO_PUBLIC_IOS_PRODUCT_ANNUAL=com.vara.wellness.annual

# Android In-App Purchase Product IDs (from Google Play Console)
EXPO_PUBLIC_ANDROID_PRODUCT_MONTHLY=vara_wellness_monthly
EXPO_PUBLIC_ANDROID_PRODUCT_ANNUAL=vara_wellness_annual

EXPO_PUBLIC_TRIAL_DURATION_DAYS=7

# Pricing (displayed on paywall)
EXPO_PUBLIC_MONTHLY_PRICE=9.99
EXPO_PUBLIC_ANNUAL_PRICE=79.99
EXPO_PUBLIC_ANNUAL_MONTHLY_EQUIVALENT=6.67
EXPO_PUBLIC_CURRENCY=USD

# ==========================================
# PRODUCTION SETTINGS
# ==========================================

EXPO_PUBLIC_USE_EMULATORS=false
