# ==========================================
# DEVELOPMENT WITH PHYSICAL DEVICE
# ==========================================
# Use this when testing on a physical device (iPhone/Android phone)
# Copy this file to .env.local and update with your local IP address
#
# How to use:
# 1. Get your computer's local IP:
#    - Windows: Run 'ipconfig' in Command Prompt
#    - Mac/Linux: Run 'ifconfig' in Terminal
# 2. Copy this file: cp .env.local.example .env.local
# 3. Update EXPO_PUBLIC_API_URL below with your IP
# 4. Restart Expo: npm start
#
# NOTE: Your phone and computer must be on the same Wi-Fi network

# ==========================================
# BACKEND API CONFIGURATION
# ==========================================

# Replace 192.168.1.100 with YOUR computer's local IP address
EXPO_PUBLIC_API_URL=http://192.168.1.100:5001
EXPO_PUBLIC_API_BASE_PATH=/api

# ==========================================
# ENVIRONMENT
# ==========================================

EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_DEBUG=true
