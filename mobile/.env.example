# ==========================================
# VARA WELLNESS MOBILE APP - ENVIRONMENT VARIABLES
# ==========================================
#
# This file is a template for the .env file
# Copy this to .env and fill in your actual values
#
# IMPORTANT: Never commit .env to version control!
#

# ==========================================
# FIREBASE CONFIGURATION
# ==========================================
# Get these values from Firebase Console:
# https://console.firebase.google.com/project/YOUR_PROJECT_ID/settings/general
# NOTE: Add the iOS and Android apps to your Firebase project

EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# iOS specific (from Firebase iOS app config)
EXPO_PUBLIC_FIREBASE_IOS_APP_ID=your_ios_app_id_here

# Android specific (from Firebase Android app config)
EXPO_PUBLIC_FIREBASE_ANDROID_APP_ID=your_android_app_id_here

# ==========================================
# BACKEND API CONFIGURATION
# ==========================================
# Your Express backend URL
# For local development: http://localhost:5001
# For production: https://your-backend-url.com

EXPO_PUBLIC_API_URL=http://localhost:5001
EXPO_PUBLIC_API_BASE_PATH=/api

# ==========================================
# APP CONFIGURATION
# ==========================================

# Environment (development, staging, production)
EXPO_PUBLIC_ENV=development

# Enable debug logging
EXPO_PUBLIC_DEBUG=true

# ==========================================
# SUBSCRIPTION CONFIGURATION (Optional - configure later)
# ==========================================

# Apple App Store In-App Purchase Product IDs
EXPO_PUBLIC_IOS_PRODUCT_MONTHLY=com.vara.monthly
EXPO_PUBLIC_IOS_PRODUCT_ANNUAL=com.vara.annual

# Google Play In-App Purchase Product IDs
EXPO_PUBLIC_ANDROID_PRODUCT_MONTHLY=vara_monthly
EXPO_PUBLIC_ANDROID_PRODUCT_ANNUAL=vara_annual

# Free trial duration (in days)
EXPO_PUBLIC_TRIAL_DURATION_DAYS=7

# Pricing (displayed on paywall)
EXPO_PUBLIC_MONTHLY_PRICE=8.99
EXPO_PUBLIC_ANNUAL_PRICE=79.99
EXPO_PUBLIC_ANNUAL_MONTHLY_EQUIVALENT=6.67
EXPO_PUBLIC_CURRENCY=USD

# ==========================================
# OPTIONAL: DEVELOPMENT SETTINGS
# ==========================================

# Set to 'true' to use Firebase emulators (for local testing)
# EXPO_PUBLIC_USE_EMULATORS=false

# ==========================================
# NOTES
# ==========================================
#
# 1. All Expo environment variables MUST start with EXPO_PUBLIC_
# 2. After changing .env, restart the Expo dev server
# 3. For EAS Build, set these in eas.json secrets or use .env files
# 4. Backend variables are in ../backend/.env
# 5. You'll need to add iOS and Android apps to Firebase Console
#
