{
  "expo": {
    "name": "Vara Wellness",
    "slug": "vara-wellness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/iOS Icon 2 - 1024x1024.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "scheme": "vara",
    "splash": {
      "image": "./assets/Splash Icon 1 - 512x512.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAF6"
    },
    "assetBundlePatterns": [
      "assets/**/*",
      "src/assets/**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vara.wellness",
      "buildNumber": "2",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Vara needs access to your camera to upload profile pictures and content.",
        "NSPhotoLibraryUsageDescription": "Vara needs access to your photo library to upload images.",
        "NSPhotoLibraryAddUsageDescription": "Vara needs access to save images to your photo library."
      }
    },
    "android": {
      "package": "com.vara.wellness",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/Adaptive Android Icon 1.png",
        "backgroundColor": "#D5E3D1"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.NOTIFICATIONS"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "vara"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1B5E57"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Vara to access your photo library to upload images."
        }
      ],
      "expo-video",
      "expo-asset"
    ],
    "owner": "kylershep",
    "extra": {
      "eas": {
        "projectId": "63c2515a-00f1-454c-8400-2514781cade6"
      }
    }
  }
}
