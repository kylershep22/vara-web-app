{
  "expo": {
    "name": "Vara Wellness",
    "slug": "vara-wellness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "vara",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B5E57"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vara.wellness",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSCameraUsageDescription": "Vara needs access to your camera to upload profile pictures and content.",
        "NSPhotoLibraryUsageDescription": "Vara needs access to your photo library to upload images.",
        "NSMicrophoneUsageDescription": "Vara needs access to your microphone for voice notes and recordings."
      }
    },
    "android": {
      "package": "com.vara.wellness",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B5E57"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "NOTIFICATIONS"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1B5E57"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Vara to access your camera to upload profile pictures and content."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Vara to access your photo library to upload images."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    },
    "owner": "YOUR_EXPO_USERNAME"
  }
}
