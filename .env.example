# ==========================================
# VARA WELLNESS APP - ENVIRONMENT VARIABLES
# ==========================================
#
# This file is a template for the .env file
# Copy this to .env and fill in your actual values
#
# IMPORTANT: Never commit .env to version control!
#

# ==========================================
# FIREBASE CONFIGURATION (Frontend)
# ==========================================
# Get these values from Firebase Console:
# https://console.firebase.google.com/project/vara-4a99f/settings/general

REACT_APP_FIREBASE_API_KEY=your_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=vara-4a99f.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=vara-4a99f
REACT_APP_FIREBASE_STORAGE_BUCKET=vara-4a99f.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
REACT_APP_FIREBASE_APP_ID=your_app_id_here

# ==========================================
# OPTIONAL: DEVELOPMENT SETTINGS
# ==========================================

# Set to 'true' to use Firebase emulators (for local testing)
# REACT_APP_USE_EMULATORS=false

# ==========================================
# WEB GATE ("coming soon")
# ==========================================
# When 'true', the web app renders a static placeholder ABOVE all routing,
# auth, and Firebase (no login/signup/Firestore reachable). Used to gate the
# hosted web app until web PMF is validated.
#   - Production (static Hosting, local build): set REACT_APP_WEB_GATED=true
#     in .env.production.local (gitignored)
#   - Production (Firebase App Hosting, cloud build): set in apphosting.yaml
#     env (committed) — gitignored .env files are absent in cloud builds
#   - Local dev (npm start): leave unset to run the full app
# REACT_APP_WEB_GATED=false

# ==========================================
# NOTES
# ==========================================
#
# 1. All React environment variables MUST start with REACT_APP_
# 2. After changing .env, you must restart the development server
# 3. For production deployment, set these in your hosting platform
# 4. Backend environment variables are in backend/.env
#
