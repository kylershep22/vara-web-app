rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    /* ==================== Helpers ==================== */

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Owner check against a uid path segment. Every user-scoped path below
    // embeds the owner uid as a matchable segment, so this resolves reliably.
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isImageType() {
      return request.resource.contentType.matches('image/.*');
    }

    function isVideoType() {
      return request.resource.contentType.matches('video/.*');
    }

    function isAudioType() {
      return request.resource.contentType.matches('audio/.*');
    }

    // Media-only guard for paths whose exact content type isn't settled yet.
    function isMediaType() {
      return isImageType() || isAudioType() || isVideoType();
    }

    // 5 MB for images. Largest image currently in the bucket is 3.17 MB.
    function underImageSizeLimit() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // 100 MB for admin audio. Raised from the previous 50 MB: the bucket
    // already holds sleep stories at 53.50 MB and 60.62 MB, which the old
    // limit would have rejected. They exist only because console uploads
    // bypass rules, so the old ceiling was never actually exercised.
    function underAudioSizeLimit() {
      return request.resource.size < 100 * 1024 * 1024;
    }

    // 200 MB for admin-authored video. No live video to calibrate against;
    // sized for a 1-2 minute explainer at comfortable bitrate, with headroom.
    function underVideoSizeLimit() {
      return request.resource.size < 200 * 1024 * 1024;
    }

    // 25 MB for anything a user uploads from their device. Deliberately far
    // below the admin ceilings — this is phone-camera content, not authored
    // media.
    function underUserUploadSizeLimit() {
      return request.resource.size < 25 * 1024 * 1024;
    }


    /* ==================== App-served media ====================
       Admin-authored content. Authenticated read on every path — never
       public: there is no reason to serve media to non-users, and public
       read invites hotlinking and egress abuse.

       Writes are admin-claim-only. No client code writes to any path in this
       section; production media lands via the Firebase Console / CLI, which
       bypasses these rules entirely. The admin write clauses exist so a
       future admin tool can upload without a rules change. */

    /* --- Paths with live content. These four MUST stay covered: omitting
           any of them sends real, in-use media to the default deny. --- */

    // Guided-protocol audio (NSDR and future practices). Read at runtime by
    // src/services/audio/protocolAudioLoader.ts. Currently holds
    // protocolAudio/nsdr/nsdr_10min_v1.mp3 and nsdr_20min_v1.mp3.
    match /protocolAudio/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isAudioType() && underAudioSizeLimit();
    }

    // Sleep sounds and sleep stories. Read at runtime by
    // src/services/firebase/library.service.ts. Holds 6 objects / 182 MB.
    match /sleep-audio/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isAudioType() && underAudioSizeLimit();
    }

    // Breathwork audio (2 objects / 105 MB) and movement audio (1 object /
    // 49 MB). NOTE: neither prefix is referenced anywhere in mobile/src or
    // web src — this content is currently orphaned. These grants make it
    // readable again; if the content is dead, delete the objects and drop
    // these two blocks rather than granting read to files nothing loads.
    match /breathwork-audio/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isAudioType() && underAudioSizeLimit();
    }

    match /movement-audio/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isAudioType() && underAudioSizeLimit();
    }

    /* --- Paths with no content yet. Declared ahead of the content so the
           rules are in place before anything is uploaded. --- */

    // Focus explainer video. Target of the focus-video-player slice; will
    // hold focusVideo/explainer/focus_explainer_v1.mp4.
    match /focusVideo/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isVideoType() && underVideoSizeLimit();
    }

    // Forward-declared media prefixes. Empty today; covered now so future
    // uploads are governed from the moment they land. `audio/` in particular
    // was referenced by legacy web code against a bucket that no longer
    // exists, so treat any content appearing here as new, not restored.
    match /focus/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isMediaType() && underVideoSizeLimit();
    }

    match /practice-audio/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isAudioType() && underAudioSizeLimit();
    }

    match /audio/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isAudioType() && underAudioSizeLimit();
    }

    /* Deliberately NOT granted: meditation-audio/, movement-video/,
       movement-thumbs/, coaching-video/, and coaching-auido/ (sic — a typo
       folder created in the console). All five are empty folder markers with
       no content and no code references. They fall through to the default
       deny. Add a block when real content lands, not before. */


    /* ==================== Profile photos ====================
       Authenticated read: community surfaces render other members' avatars
       and banners, so owner-scoped read would break them. This also matches
       the Firestore rule governing the same data — `match /users/{userId}`
       in firestore.rules allows read to any authenticated user.
       Writes stay owner-scoped. */

    // Live profile path. Written by mobile ProfileScreen.tsx as
    // users/{uid}/{avatar|banner}_{ts}.jpg, and by web ProfilePage.jsx /
    // UserProfilePage.jsx as users/{uid}/{avatar|banner}_{ts}.
    match /users/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isImageType() && underImageSizeLimit();
    }

    // Legacy avatar path, still written by web EditProfile.jsx and
    // Settings.jsx as avatars/{uid}/{file.name}. Holds one object.
    // Read widened from owner-only to authenticated to match users/ above —
    // under the previous owner-only rule, an avatar uploaded through the web
    // Settings page was not readable by anyone else.
    match /avatars/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isImageType() && underImageSizeLimit();
    }


    /* ==================== Community content ====================
       Post attachments are rendered to other members by design, so read is
       authenticated rather than owner-scoped — consistent with the Firestore
       `match /posts/{postId}` rule. Writes stay owner-scoped. */

    // Post attachments. Written by mobile storage.service.ts as
    // posts/{uid}/{img|vid}_{ts}_{rand}.{ext} and by web CommunityPage.jsx as
    // posts/{uid}/{ts}_{filename}.
    // isVideoType() is included because uploadPostVideo() has shipped in
    // storage.service.ts; an images-only rule rejects it, which is why client
    // video posting is currently broken.
    match /posts/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && (
                        (isImageType() && underImageSizeLimit()) ||
                        (isVideoType() && underUserUploadSizeLimit())
                      );
    }

    // Separate legacy prefix from posts/. Holds one object.
    match /communityPosts/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isImageType() && underImageSizeLimit();
    }

    // Group post images. NOTE: the owner uid is the THIRD segment here —
    // groupId sits between the prefix and the uid. Written by web
    // GroupForumPage.jsx. No objects currently.
    match /groupPosts/{groupId}/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isImageType() && underImageSizeLimit();
    }


    /* ==================== Private user data ====================
       Owner-scoped read AND write. Declared defensively: neither prefix
       exists in the bucket today, and the corresponding Firestore
       collections (reflections, brainStateCheckIns et al.) hold text
       documents with no file attachments. If either ever holds media, it is
       personal by nature and must never be readable by another member.

       Both rules assume a uid-first layout — checkins/{uid}/... — matching
       the convention every existing user path already follows. Content type
       is constrained to media and capped; tighten once the actual use is
       known. */

    match /checkins/{userId}/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isMediaType() && underUserUploadSizeLimit();
    }

    match /reflections/{userId}/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isMediaType() && underUserUploadSizeLimit();
    }


    /* ==================== Default deny ====================
       Anything not explicitly matched above is denied for both read and
       write. There is no public read and no public write anywhere in this
       ruleset. */
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
