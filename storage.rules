rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    /* -------- Helpers -------- */
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    /* -------- Avatars --------
       Each user may read/write their own avatar files. */
    match /avatars/{userId}/{fileName} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    /* -------- User Profile Images (avatars and banners) --------
       Each user may read/write their own profile images. */
    match /users/{userId}/{fileName} {
      allow read: if isSignedIn(); // Anyone signed in can view profile images
      allow write: if isSignedIn() && request.auth.uid == userId; // Only owner can upload
    }

    /* -------- Post Images --------
       Users can upload images for their posts. */
    match /posts/{userId}/{fileName} {
      allow read: if isSignedIn(); // Anyone signed in can view post images
      allow write: if isSignedIn() && request.auth.uid == userId; // Only owner can upload
    }

    /* -------- Group Post Images --------
       Users can upload images for group posts. */
    match /groupPosts/{groupId}/{fileName} {
      allow read: if isSignedIn(); // Anyone signed in can view group post images
      allow write: if isSignedIn(); // Any signed in user can upload to groups they're in
    }

    /* -------- Community Post Images --------
       Users can upload images for community posts. */
    match /communityPosts/{userId}/{fileName} {
      allow read: if isSignedIn(); // Anyone signed in can view community post images
      allow write: if isSignedIn() && request.auth.uid == userId; // Only owner can upload
    }

    /* -------- Sleep Audio --------
       Clients may read (stream) when signed in.
       Only admins may upload/overwrite/delete. */
    match /sleep-audio/{allPaths=**} {
      // Change to 'true' if you want public streaming before login
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /* -------- Default deny -------- */
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
