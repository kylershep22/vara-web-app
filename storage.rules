rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    /* -------- Helpers -------- */
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isImageType() {
      return request.resource.contentType.matches('image/.*');
    }

    function isAudioType() {
      return request.resource.contentType.matches('audio/.*');
    }

    // 5 MB limit for images
    function underImageSizeLimit() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // 50 MB limit for audio
    function underAudioSizeLimit() {
      return request.resource.size < 50 * 1024 * 1024;
    }

    /* -------- Avatars --------
       Each user may read/write their own avatar files. */
    match /avatars/{userId}/{fileName} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId
                      && isImageType() && underImageSizeLimit();
    }

    /* -------- User Profile Images (avatars and banners) --------
       Each user may read/write their own profile images. */
    match /users/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId
                      && isImageType() && underImageSizeLimit();
    }

    /* -------- Post Images --------
       Users can upload images for their posts. */
    match /posts/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId
                      && isImageType() && underImageSizeLimit();
    }

    /* -------- Group Post Images --------
       Users can upload images for group posts.
       Path includes userId to enforce ownership of uploaded files. */
    match /groupPosts/{groupId}/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId
                      && isImageType() && underImageSizeLimit();
    }

    /* -------- Community Post Images --------
       Users can upload images for community posts. */
    match /communityPosts/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId
                      && isImageType() && underImageSizeLimit();
    }

    /* -------- Sleep Audio --------
       Clients may read (stream) when signed in.
       Only admins may upload/overwrite/delete. */
    match /sleep-audio/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin()
                      && isAudioType() && underAudioSizeLimit();
    }

    /* -------- Default deny -------- */
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
