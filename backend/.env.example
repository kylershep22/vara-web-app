# ==========================================
# VARA WELLNESS APP - BACKEND ENVIRONMENT VARIABLES
# ==========================================
#
# This file is a template for backend/.env
# Copy this to backend/.env and fill in your actual values
#
# IMPORTANT: Never commit .env to version control!
#

# ==========================================
# OPENAI API CONFIGURATION
# ==========================================
# Get your API key from: https://platform.openai.com/api-keys

OPENAI_API_KEY=sk-your-openai-api-key-here

# ==========================================
# SERVER CONFIGURATION
# ==========================================

# Port for Express server (default: 5001)
PORT=5001

# ==========================================
# OPTIONAL: SENDGRID (for notifications)
# ==========================================
# If you want email notifications via SendGrid
# Get key from: https://app.sendgrid.com/settings/api_keys

# SENDGRID_API_KEY=your-sendgrid-api-key-here

# ==========================================
# NOTES
# ==========================================
#
# 1. The backend uses dotenv to load these variables
# 2. Restart the server after changing this file
# 3. For production, set these in your hosting platform
# 4. Frontend environment variables are in the root .env file
#
