{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint ./index.js || echo lint ignored",
    "test": "firebase emulators:exec --only firestore,auth,storage \"jest --testEnvironment=node --runInBand src/__tests__\"",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:unit": "jest --testEnvironment=node --runInBand src/__tests__/rateLimit.test.js src/__tests__/userFields.test.js src/__tests__/deleteAccountCleanup.test.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0",
    "openai": "^5.16.0"
  },
  "devDependencies": {
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0",
    "firebase": "^11.10.0",
    "firebase-functions-test": "^3.1.0",
    "jest": "^30.0.4"
  },
  "private": true
}
